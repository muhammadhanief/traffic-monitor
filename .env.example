# Salin jadi .env lalu sesuaikan.
# DB_HOST: 127.0.0.1 kalau script jalan di PC yang sama dengan MySQL,
#          atau IP LAN PC MySQL (mis. 10.33.6.11) kalau dari PC lain.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=netflow
DB_PASSWORD=ganti-dengan-password
DB_NAME=netflow_monitor
# jumlah koneksi paralel di pool (opsional)
# DB_POOL=4

# ===== MikroTik (dipakai sync-mikrotik.js & sync-router.js) =====
# Port 80 = HTTP polos (service 'www', tanpa sertifikat):
#   /ip service set www disabled=no
#   /ip service set www address=<IP-server>/32
# Port 443 = HTTPS (service 'www-ssl', wajib punya sertifikat):
#   /ip service set www-ssl disabled=no
#   /ip service set www-ssl available-from=<IP-server>/32
#   /ip service set www-ssl certificate=<nama-sertifikat>
# Grup user harus punya policy read,api,rest-api.
MIKROTIK_HOST=10.33.0.254
MIKROTIK_PORT=80
MIKROTIK_USER=collector
MIKROTIK_PASSWORD=ganti-dengan-password-collector
# MIKROTIK_SCHEME=http        # opsional: paksa http/https (default dari port)
MIKROTIK_TLS_VERIFY=0           # 1 kalau router pakai sertifikat resmi
DNS_KEEP_DAYS=1825              # retensi dns_map (5 tahun)

# ===== sync-router.js (kesehatan/port/sesi/log router) =====
LOG_KEEP_DAYS=30                # retensi router_log
SESSION_KEEP_DAYS=180           # retensi router_session
# UPLINK_PORTS=ether1,ether7    # port yang ditandai sebagai uplink di port_map

# ===== User MySQL khusus aplikasi web (dibuat otomatis, lihat README) =====
# Hanya SELECT + UPDATE kolom manual devices(nama,pemilik,grup).
APP_DB_USER=netflow_app
APP_DB_PASSWORD=diisi-saat-user-dibuat