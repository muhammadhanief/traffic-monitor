{
  "name": "netflow-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ingest": "node --env-file-if-exists=.env ingest.js",
    "report": "node --env-file-if-exists=.env report.js",
    "rollup": "node --env-file-if-exists=.env rollup.js",
    "rollup:hourly": "node --env-file-if-exists=.env rollup.js --hourly",
    "rollup:daily": "node --env-file-if-exists=.env rollup.js --daily",
