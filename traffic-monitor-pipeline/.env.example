# Salin jadi .env lalu sesuaikan:  copy .env.example .env
# Semua variabel di bawah ini OPSIONAL kecuali yang ditandai (wajib).
# Nilai di kanan tanda "=" adalah default bawaan kode kalau barisnya dihapus.

# ===== Database (wajib: DB_USER, DB_PASSWORD, DB_NAME) =====
# DB_HOST: 127.0.0.1 kalau script jalan di PC yang sama dengan MySQL,
#          atau IP LAN PC MySQL (mis. 10.33.6.11) kalau dari PC lain.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=netflow
DB_PASSWORD=ganti-dengan-password
DB_NAME=netflow_monitor
# DB_POOL=4                     # jumlah koneksi paralel di pool (default 4)

# ===== Retensi (hari, dibaca ingest.js & rollup.js) =====
KEEP_DETAIL_DAYS=3              # flows_5m (detail tujuan 5 menit)
KEEP_MINUTE_DAYS=30             # traffic_1m (ringkasan per menit)
KEEP_HOUR_DAYS=730              # traffic_1h (2 tahun)
KEEP_DAILY_IP_DAYS=1825         # flows_daily_ip (5 tahun)
KEEP_SVC_HOUR_DAYS=90           # svc_hourly (layanan per jam)
KEEP_SVC_DAILY_DAYS=730         # svc_daily (layanan per hari, 2 tahun)
# traffic_daily, traffic_monthly, flows_monthly_ip: disimpan selamanya

# ===== Ambang penyimpanan IP tujuan (rollup.js) =====
IP_DAILY_MIN_BYTES=20971520     # 20 MB/hari per perangkat per IP
IP_MONTHLY_MIN_BYTES=52428800   # 50 MB/bulan

# ===== Jendela hitung ulang rollup (rollup.js, jarang perlu diubah) =====
# Berapa lama ke belakang data dihitung ulang tiap kali rollup jalan.
# Saat `--backfill` nilainya diabaikan (memakai lebar retensi penuh).
# ROLLUP_HOUR_WINDOW=26         # jam
# ROLLUP_DAY_WINDOW=2           # hari
# ROLLUP_DETAIL_WINDOW=3        # hari (default = KEEP_DETAIL_DAYS)
# ROLLUP_SVC_HOUR_WINDOW=3      # jam; jendela hitung ulang svc_hourly
# Untuk mengisi tabel layanan dari awal / setelah task mati:
#   node --env-file-if-exists=.env rollup.js --svc --backfill

# ===== ingest.js: pengumpul NetFlow =====
# GOFLOW_PATH=C:\Users\ipds3\Downloads\goflow2-2.2.7-windows-amd64.exe   # (wajib di Windows)
# GOFLOW_LISTEN=netflow://:2055   # alamat & port yang didengarkan goflow2
# BRIDGE_IF=20                    # ifIndex bridge di router (samakan dengan /interface print)
# FLUSH_SEC=60                    # interval tulis ke MySQL
# NAT_TTL_SEC=1200                # umur catatan koneksi upload
# PENDING_SEC=120                 # lama menunggu pasangan download

# ===== MikroTik (dipakai sync-mikrotik.js & sync-router.js) =====
# Port 80 = HTTP polos (service 'www', tanpa sertifikat):
#   /ip service set www disabled=no
#   /ip service set www address=<IP-server>/32
# Port 443 = HTTPS (service 'www-ssl', wajib punya sertifikat):
#   /ip service set www-ssl disabled=no
#   /ip service set www-ssl available-from=<IP-server>/32
#   /ip service set www-ssl certificate=<nama-sertifikat>
# Grup user harus punya policy read,api,rest-api.
MIKROTIK_HOST=10.33.0.254
MIKROTIK_PORT=80
MIKROTIK_USER=collector
MIKROTIK_PASSWORD=ganti-dengan-password-collector
# MIKROTIK_SCHEME=http        # opsional: paksa http/https (default dari port)
MIKROTIK_TLS_VERIFY=0           # 1 kalau router pakai sertifikat resmi
MIKROTIK_TIMEOUT_MS=15000
DNS_KEEP_DAYS=1825              # retensi dns_map (5 tahun)

# ===== sync-router.js (kesehatan/port/sesi/log router) =====
LOG_KEEP_DAYS=30                # retensi router_log
SESSION_KEEP_DAYS=180           # retensi router_session
# UPLINK_PORTS=ether1,ether7    # port yang ditandai sebagai uplink di port_map

# ===== Diagnostik =====
# Tulis N record NetFlow mentah pertama ke logs/ingest.log (0 = mati).
RAW_DUMP=0

# ===== migrate-to-mysql.js (sekali pakai, SQLite -> MySQL) =====
# SQLITE_PATH=data/flows.db

# ===== User MySQL khusus aplikasi web (dibuat manual, lihat README) =====
# Hanya SELECT + UPDATE kolom manual devices(nama,pemilik,grup).
# Tidak dibaca script di repo ini; dipakai aplikasi web di repo/PC lain.
APP_DB_USER=netflow_app
APP_DB_PASSWORD=diisi-saat-user-dibuat