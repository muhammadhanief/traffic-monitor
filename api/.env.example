# ==========================================================================
#  API dashboard NetFlow Monitor — contoh konfigurasi.
#  Salin menjadi .env untuk dijalankan lokal. Di Vercel, isi variabel ini
#  di Settings > Environment Variables (jangan commit .env).
# ==========================================================================

PORT=3001

# ---------- database data (netflow_monitor) — HANYA BACA ----------
# User ini tidak boleh punya hak tulis apa pun (lihat README-MYSQL.md bagian 11).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=netflow_app
DB_PASSWORD=
DB_NAME=netflow_monitor

# ---------- database konfigurasi aplikasi — HANYA UNTUK MENULIS ----------
# Tabel konfigurasi (segment, service_map, alert_rule, alert_event, setting)
# hidup DI DALAM netflow_monitor, satu skema dengan data. Yang dipisah adalah
# HAK AKSES: DB_USER di atas tetap read-only, CFG_DB_USER hanya boleh
# INSERT/UPDATE/DELETE pada 5 tabel konfigurasi + UPDATE kolom manual devices.
#
# Bila CFG_DB_USER dikosongkan, pool tulis memakai DB_USER (cukup untuk uji
# lokal dengan user netflow). Di produksi JANGAN: DB_USER harus read-only.
# Lihat sql/config-schema.sql dan README.md bagian 2.
CFG_DB_HOST=
CFG_DB_PORT=
CFG_DB_USER=
CFG_DB_PASSWORD=
# Kosongkan untuk memakai DB_NAME. Hanya diisi bila konfigurasi ditaruh di
# skema lain (tidak disarankan; daftar putih tabel ada di routes/config.js).
CFG_DB_NAME=

# ---------- koneksi & cache ----------
# Vercel menjalankan banyak lambda; jaga angka ini kecil agar
# max_connections MySQL (default 151) tidak habis.
DB_POOL_SIZE=3
# Ulangi pembukaan koneksi bila ETIMEDOUT/ECONNREFUSED (link lintas internet).
# Waktu tunggu terburuk ≈ DB_CONNECT_TIMEOUT_MS × DB_CONNECT_RETRIES.
DB_CONNECT_RETRIES=2
DB_CONNECT_TIMEOUT_MS=6000
CACHE_TTL_SECONDS=60
META_TTL_SECONDS=30

# ---------- CORS ----------
# Frontend ada di cPanel BPS. Browser-lah yang memanggil API ini.
CORS_ORIGINS=https://traffic-monitor.web.bps.go.id,http://localhost:3000

# ---------- batas keamanan/kinerja ----------
# flows_5m melompat dari 182 ms (3 jam) ke 12 detik (6 jam). Jangan dinaikkan
# tanpa mengukur ulang.
SEARCH_MAX_HOURS=3
RATE_LIMIT_PER_MINUTE=60

# ---------- SSO BPS (accounts.bps.go.id) ----------
# API hanya MEMVERIFIKASI Bearer token. Login (Authorization Code) dilakukan
# oleh frontend Next.js di cPanel. Kosongkan AUTH_DISABLED=1 saat uji lokal.
AUTH_DISABLED=1
SSO_ISSUER=https://accounts.bps.go.id/realms/pegawai
SSO_AUDIENCE=
SSO_JWKS_URI=https://accounts.bps.go.id/realms/pegawai/protocol/openid-connect/certs
# Peran yang boleh mengubah konfigurasi (nama perangkat, segmen, alert).
SSO_ADMIN_ROLES=admin,superadmin

# ---------- peringatan ----------
ALERTS_ENABLED=1
